<!-- Sdk.Web y no Sdk.Worker: el sincronizador sirve su propia interfaz de
     monitoreo en el mismo proceso, para que la pantalla lea el estado en vivo
     de la memoria compartida en vez de inventar comunicación entre procesos.
     Los modos de diagnóstico siguen arrancando SIN servidor web — ver la
     bifurcación en Program.cs. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DinasWms.SapSync</RootNamespace>
    <!-- Se corre como consola en esta fase de ensayo-error. Se instalará como
         Windows Service más adelante sin cambiar la lógica de negocio. -->
    <OutputType>Exe</OutputType>
    <UserSecretsId>dinas-wms-sap-sync</UserSecretsId>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

</Project>
